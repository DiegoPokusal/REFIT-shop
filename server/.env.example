# Skopíruj tento súbor ako ".env" pre lokálny beh, alebo nastav tieto
# premenné priamo v Railway (Settings → Variables). Nikdy necommituj
# skutočný ".env" súbor so skutočnými kľúčmi do gitu.

# Stripe → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Stripe → Developers → Webhooks → (po vytvorení endpointu) → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Doména živého shopu (pre návrat po platbe)
SITE_URL=https://refitvintage.sk

# Existujúci server, ktorý spracúva objednávky (ten istý, čo dnes prijíma
# surové objednávky cez /api/order)
ORDER_SERVER_URL=https://glorious-optimism-production-0039.up.railway.app

# Odkiaľ smú prichádzať požiadavky (tvoja stránka)
ALLOWED_ORIGIN=https://refitvintage.sk

# Cena dopravy v centoch (3.50 € = 350)
SHIPPING_PRICE_CENTS=350

# Povolené krajiny doručenia, oddelené čiarkou
ALLOWED_SHIPPING_COUNTRIES=SK,CZ

PORT=4000
